# Port HTTP/WebSocket
PORT=4000
# Secret JWT (à changer en production)
JWT_SECRET=changez-moi-en-production
# Fournisseur de données : auto | live | simulation
DATA_PROVIDER=auto
# Intervalle de rafraîchissement des cours en direct (ms)
LIVE_POLL_INTERVAL_MS=15000
# Intervalle des ticks simulés (ms)
SIM_TICK_INTERVAL_MS=2000
# Chemin de la base SQLite
DB_PATH=./data/crackenmarket.db
# Origine autorisée pour le CORS (frontend)
CORS_ORIGIN=http://localhost:5173
# SGI partenaires : par défaut, les ordres réels sont traités dans la console SGI intégrée.
# Pour une connexion directe au back-office du partenaire, définir l'URL et le secret HMAC :
# SGI_MATHA_WEBHOOK_URL=https://backoffice.mathasecurities.example/crackenmarket/orders
# SGI_MATHA_WEBHOOK_SECRET=secret-partagé-avec-matha
# Veille d'actualité : flux RSS supplémentaires (séparés par des virgules), en plus de BRVM / Financial Afrik / Sika Finance
# NEWS_FEEDS=https://exemple.com/feed/
